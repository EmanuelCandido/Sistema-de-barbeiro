rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }
    function bookingLockPath(uid) {
      return /databases/$(database)/documents/customerBookingLocks/$(uid);
    }
    function availabilityPath(dateKey) {
      return /databases/$(database)/documents/publicAvailability/$(dateKey);
    }
    function exceptionPath(dateKey) {
      return /databases/$(database)/documents/exceptions/$(dateKey);
    }
    function settingsPath() {
      return /databases/$(database)/documents/settings/public;
    }
    function servicePath(serviceId) {
      return /databases/$(database)/documents/services/$(serviceId);
    }
    function isOwner() {
      return signedIn() && exists(userPath()) &&
        get(userPath()).data.role == "owner" &&
        get(userPath()).data.active == true;
    }
    function isPublicClient() {
      return signedIn() && !exists(userPath());
    }
    function ownsBooking(data) {
      return signedIn() && data.createdByUid == request.auth.uid;
    }
    function validOpaqueId(value) {
      return value is string &&
        value.matches('^[A-Za-z0-9_-]{16,128}$');
    }
    function validPeriod(period) {
      return period is map &&
        period.keys().hasOnly(["start", "end"]) &&
        period.start is string &&
        period.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        period.end is string &&
        period.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        period.start < period.end;
    }
    function validPeriodList(periods) {
      return periods is list &&
        periods.size() <= 3 &&
        (periods.size() < 1 || validPeriod(periods[0])) &&
        (periods.size() < 2 || validPeriod(periods[1])) &&
        (periods.size() < 3 || validPeriod(periods[2])) &&
        (periods.size() < 2 || periods[0].end <= periods[1].start) &&
        (periods.size() < 3 || periods[1].end <= periods[2].start);
    }
    // Only owners can write settings. Keeping the per-day check bounded here avoids
    // Firestore's 1,000-expression limit; the owner app validates every period.
    function validSchedulePeriodList(periods) {
      return periods is list && periods.size() <= 3;
    }
    function validWeeklySchedule(schedule) {
      return schedule is map &&
        schedule.keys().hasOnly(["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]) &&
        schedule.keys().hasAll(["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]) &&
        validSchedulePeriodList(schedule.sunday) &&
        validSchedulePeriodList(schedule.monday) &&
        validSchedulePeriodList(schedule.tuesday) &&
        validSchedulePeriodList(schedule.wednesday) &&
        validSchedulePeriodList(schedule.thursday) &&
        validSchedulePeriodList(schedule.friday) &&
        validSchedulePeriodList(schedule.saturday);
    }
    function validSettings(data) {
      return data.keys().hasOnly(["businessName", "publicPhone", "timezone", "slotIntervalMinutes", "minimumNoticeMinutes", "bookingAdvanceDays", "weeklySchedule", "updatedAt"]) &&
        data.keys().hasAll(["businessName", "publicPhone", "timezone", "slotIntervalMinutes", "minimumNoticeMinutes", "bookingAdvanceDays", "weeklySchedule", "updatedAt"]) &&
        data.businessName is string &&
        data.businessName.size() >= 2 &&
        data.businessName.size() <= 80 &&
        data.publicPhone is string &&
        data.publicPhone.matches('^[0-9]{10,13}$') &&
        data.timezone == "America/Recife" &&
        data.slotIntervalMinutes is int &&
        data.slotIntervalMinutes >= 5 &&
        data.slotIntervalMinutes <= 120 &&
        data.minimumNoticeMinutes is int &&
        data.minimumNoticeMinutes >= 0 &&
        data.minimumNoticeMinutes <= 10080 &&
        data.bookingAdvanceDays is int &&
        data.bookingAdvanceDays >= 1 &&
        data.bookingAdvanceDays <= 180 &&
        validWeeklySchedule(data.weeklySchedule) &&
        data.updatedAt is timestamp;
    }
    function validService(data) {
      return data.keys().hasOnly(["name", "description", "iconKey", "durationMinutes", "priceCents", "active", "sortOrder", "createdAt", "updatedAt"]) &&
        data.keys().hasAll(["name", "durationMinutes", "priceCents", "active", "sortOrder", "createdAt", "updatedAt"]) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 80 &&
        (!data.keys().hasAny(["description"]) ||
          (data.description is string && data.description.size() <= 160)) &&
        (!data.keys().hasAny(["iconKey"]) ||
          data.iconKey in ["none", "complete", "scissors-comb", "scissors", "shaver", "beard", "mustache", "brush", "chair", "spray"]) &&
        data.durationMinutes is int &&
        data.durationMinutes >= 5 &&
        data.durationMinutes <= 480 &&
        data.priceCents is int &&
        data.priceCents >= 0 &&
        data.priceCents <= 10000000 &&
        data.active is bool &&
        data.sortOrder is int &&
        data.sortOrder >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }
    function validException(data) {
      return data.keys().hasOnly(["closed", "customPeriods", "reason", "updatedAt"]) &&
        data.keys().hasAll(["closed", "updatedAt"]) &&
        data.closed is bool &&
        (!data.keys().hasAny(["customPeriods"]) || validPeriodList(data.customPeriods)) &&
        (!data.keys().hasAny(["reason"]) ||
          (data.reason is string && data.reason.size() <= 160)) &&
        data.updatedAt is timestamp;
    }
    function validSlotList(slots) {
      return slots is list &&
        slots.size() >= 1 &&
        slots.size() <= 8 &&
        slots.toSet().size() == slots.size() &&
        slots[0] is string &&
        slots[0].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function timeMinutes(value) {
      return int(value[0:2]) * 60 + int(value[3:5]);
    }
    function localTimestamp(value) {
      return value - duration.value(3, 'h');
    }
    function weeklyPeriods(schedule, dayOfWeek) {
      return dayOfWeek == 1 ? schedule.monday :
        dayOfWeek == 2 ? schedule.tuesday :
        dayOfWeek == 3 ? schedule.wednesday :
        dayOfWeek == 4 ? schedule.thursday :
        dayOfWeek == 5 ? schedule.friday :
        dayOfWeek == 6 ? schedule.saturday :
        schedule.sunday;
    }
    function effectivePeriods(data, settings) {
      let hasException = exists(exceptionPath(data.dateKey));
      let exception = hasException ? get(exceptionPath(data.dateKey)).data : {};
      return hasException && exception.closed
        ? []
        : hasException && exception.keys().hasAny(["customPeriods"])
          ? exception.customPeriods
          : weeklyPeriods(
              settings.weeklySchedule,
              localTimestamp(data.startAt).dayOfWeek()
            );
    }
    function fitsPeriod(startTime, endTime, startMinutes, period, interval) {
      return startTime >= period.start &&
        endTime <= period.end &&
        (startMinutes - timeMinutes(period.start)) % interval == 0;
    }
    function fitsConfiguredSchedule(data, settings, startMinutes) {
      let periods = effectivePeriods(data, settings);
      return (periods.size() > 0 && fitsPeriod(data.startTime, data.endTime, startMinutes, periods[0], settings.slotIntervalMinutes)) ||
        (periods.size() > 1 && fitsPeriod(data.startTime, data.endTime, startMinutes, periods[1], settings.slotIntervalMinutes)) ||
        (periods.size() > 2 && fitsPeriod(data.startTime, data.endTime, startMinutes, periods[2], settings.slotIntervalMinutes));
    }
    function validLocalDateTime(data, startMinutes) {
      let start = localTimestamp(data.startAt);
      return start.date() == timestamp.date(
          int(data.dateKey[0:4]),
          int(data.dateKey[5:7]),
          int(data.dateKey[8:10])
        ) &&
        start.time() == duration.value(startMinutes, 'm');
    }
    function validSequentialSlot(slots, startMinutes, interval, index) {
      return slots[index] is string &&
        slots[index].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        timeMinutes(slots[index]) == startMinutes + index * interval;
    }
    function validSequentialSlots(data, interval, startMinutes) {
      let slots = data.occupiedSlotKeys;
      return slots.size() < 2 ||
        (validSequentialSlot(slots, startMinutes, interval, 1) &&
          (slots.size() < 3 ||
            (validSequentialSlot(slots, startMinutes, interval, 2) &&
              (slots.size() < 4 ||
                (validSequentialSlot(slots, startMinutes, interval, 3) &&
                  (slots.size() < 5 ||
                    (validSequentialSlot(slots, startMinutes, interval, 4) &&
                      (slots.size() < 6 ||
                        (validSequentialSlot(slots, startMinutes, interval, 5) &&
                          (slots.size() < 7 ||
                            (validSequentialSlot(slots, startMinutes, interval, 6) &&
                              (slots.size() < 8 ||
                                validSequentialSlot(slots, startMinutes, interval, 7)))))))))))));
    }
    function validServiceId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 128 &&
        value.matches('^[A-Za-z0-9_-]+$');
    }
    function validServiceIdList(serviceIds) {
      return serviceIds is list &&
        serviceIds.size() >= 1 &&
        serviceIds.size() <= 4 &&
        serviceIds.toSet().size() == serviceIds.size() &&
        validServiceId(serviceIds[0]) &&
        (serviceIds.size() < 2 || validServiceId(serviceIds[1])) &&
        (serviceIds.size() < 3 || validServiceId(serviceIds[2])) &&
        (serviceIds.size() < 4 || validServiceId(serviceIds[3]));
    }
    function validBookingShape(data) {
      return data.keys().hasOnly(["dateKey", "startTime", "endTime", "startAt", "endAt", "expiresAt", "occupiedSlotKeys", "serviceId", "serviceIds", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot", "clientName", "clientPhone", "clientNote", "status", "paymentMethod", "lastCustomerMutation", "createdByUid", "createdAt", "updatedAt"]) &&
        data.keys().hasAll(["dateKey", "startTime", "endTime", "startAt", "endAt", "occupiedSlotKeys", "serviceId", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot", "clientName", "clientPhone", "status", "createdByUid", "createdAt", "updatedAt"]) &&
        data.dateKey is string &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string &&
        data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.endTime is string &&
        data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.startTime < data.endTime &&
        data.startAt is timestamp &&
        data.endAt is timestamp &&
        data.endAt > data.startAt &&
        (!data.keys().hasAny(["expiresAt"]) || data.expiresAt is timestamp) &&
        (data.status in ["cancelled", "completed"]
          ? data.keys().hasAny(["expiresAt"])
          : !data.keys().hasAny(["expiresAt"])) &&
        validSlotList(data.occupiedSlotKeys) &&
        data.occupiedSlotKeys[0] == data.startTime &&
        data.serviceId is string &&
        data.serviceId.size() >= 1 &&
        data.serviceId.size() <= 128 &&
        (!data.keys().hasAny(["serviceIds"]) || validServiceIdList(data.serviceIds)) &&
        data.serviceNameSnapshot is string &&
        data.serviceNameSnapshot.size() >= 2 &&
        data.serviceNameSnapshot.size() <= 320 &&
        data.durationMinutesSnapshot is int &&
        data.durationMinutesSnapshot >= 5 &&
        data.durationMinutesSnapshot <= 480 &&
        data.priceCentsSnapshot is int &&
        data.priceCentsSnapshot >= 0 &&
        data.priceCentsSnapshot <= 10000000 &&
        data.clientName is string &&
        data.clientName.size() >= 2 &&
        data.clientName.size() <= 80 &&
        data.clientPhone is string &&
        data.clientPhone.matches('^[0-9]{10,11}$') &&
        (!data.keys().hasAny(["clientNote"]) ||
          (data.clientNote is string && data.clientNote.size() <= 300)) &&
        data.status in ["pending", "confirmed", "completed", "cancelled"] &&
        (!data.keys().hasAny(["paymentMethod"]) ||
          data.paymentMethod in ["pix", "cash", "card"]) &&
        (!data.keys().hasAny(["lastCustomerMutation"]) ||
          data.lastCustomerMutation in ["create", "cancel", "reschedule"]) &&
        data.createdByUid is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }
    function validCustomerCreateShape(data) {
      return data.keys().hasOnly(["dateKey", "startTime", "endTime", "startAt", "endAt", "occupiedSlotKeys", "serviceId", "serviceIds", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot", "clientName", "clientPhone", "clientNote", "status", "lastCustomerMutation", "createdByUid", "createdAt", "updatedAt"]) &&
        data.keys().hasAll(["dateKey", "startTime", "endTime", "startAt", "endAt", "occupiedSlotKeys", "serviceId", "serviceIds", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot", "clientName", "clientPhone", "status", "lastCustomerMutation", "createdByUid", "createdAt", "updatedAt"]) &&
        validSlotList(data.occupiedSlotKeys) &&
        data.occupiedSlotKeys[0] == data.startTime &&
        data.clientName is string &&
        data.clientName.size() >= 2 &&
        data.clientName.size() <= 80 &&
        data.clientPhone is string &&
        data.clientPhone.matches('^[0-9]{10,11}$') &&
        (!data.keys().hasAny(["clientNote"]) ||
          (data.clientNote is string && data.clientNote.size() <= 300));
    }
    function validRescheduleFields(data) {
      return data.dateKey is string &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.endTime is string &&
        data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        validSlotList(data.occupiedSlotKeys) &&
        data.occupiedSlotKeys[0] == data.startTime;
    }
    function validAvailability(data) {
      return data.keys().hasOnly(["occupiedSlotKeys", "lastMutationId", "lastMutationType", "updatedAt"]) &&
        data.keys().hasAll(["occupiedSlotKeys", "lastMutationId", "updatedAt"]) &&
        data.occupiedSlotKeys is list &&
        data.occupiedSlotKeys.size() <= 288 &&
        data.occupiedSlotKeys.toSet().size() == data.occupiedSlotKeys.size() &&
        data.lastMutationId is string &&
        data.lastMutationId.size() >= 1 &&
        data.lastMutationId.size() <= 128 &&
        (!data.keys().hasAny(["lastMutationType"]) ||
          data.lastMutationType in ["create", "cancel", "reschedule-same", "reschedule-source", "reschedule-target"]) &&
        data.updatedAt is timestamp;
    }
    function validCustomerAvailabilityShape(data) {
      return data.keys().hasOnly(["occupiedSlotKeys", "lastMutationId", "lastMutationType", "updatedAt"]) &&
        data.keys().hasAll(["occupiedSlotKeys", "lastMutationId", "lastMutationType", "updatedAt"]);
    }
    function validSummary(data) {
      return data.keys().hasOnly(["completedRevenueCents", "expectedRevenueCents", "completedAppointments", "confirmedAppointments", "cancelledAppointments", "pixRevenueCents", "cashRevenueCents", "cardRevenueCents", "updatedAt"]) &&
        data.keys().hasAll(["completedRevenueCents", "expectedRevenueCents", "completedAppointments", "confirmedAppointments", "cancelledAppointments", "pixRevenueCents", "cashRevenueCents", "cardRevenueCents", "updatedAt"]) &&
        data.completedRevenueCents is int &&
        data.expectedRevenueCents is int &&
        data.completedAppointments is int &&
        data.confirmedAppointments is int &&
        data.cancelledAppointments is int &&
        data.pixRevenueCents is int &&
        data.cashRevenueCents is int &&
        data.cardRevenueCents is int &&
        data.updatedAt is timestamp;
    }
    function validTiming(data) {
      let settings = get(settingsPath()).data;
      let startMinutes = timeMinutes(data.startTime);
      let endMinutes = timeMinutes(data.endTime);
      return validLocalDateTime(data, startMinutes) &&
        data.endAt == data.startAt + duration.value(data.durationMinutesSnapshot, 'm') &&
        endMinutes == startMinutes + data.durationMinutesSnapshot &&
        data.startAt >= request.time + duration.value(settings.minimumNoticeMinutes, 'm') &&
        data.startAt <= request.time + duration.value(settings.bookingAdvanceDays + 1, 'd') &&
        data.occupiedSlotKeys.size() * settings.slotIntervalMinutes >= data.durationMinutesSnapshot &&
        (data.occupiedSlotKeys.size() - 1) * settings.slotIntervalMinutes < data.durationMinutesSnapshot &&
        validSequentialSlots(data, settings.slotIntervalMinutes, startMinutes);
    }
    function oneServiceSnapshotIsCurrent(data) {
      let first = get(servicePath(data.serviceIds[0])).data;
      return first.active == true &&
        data.serviceId == data.serviceIds[0] &&
        data.serviceNameSnapshot == first.name &&
        data.durationMinutesSnapshot == first.durationMinutes &&
        data.priceCentsSnapshot == first.priceCents;
    }
    function twoServiceSnapshotIsCurrent(data) {
      let first = get(servicePath(data.serviceIds[0])).data;
      let second = get(servicePath(data.serviceIds[1])).data;
      return first.active == true &&
        second.active == true &&
        data.serviceIds[0] != data.serviceIds[1] &&
        data.serviceId == data.serviceIds[0] + "+" + data.serviceIds[1] &&
        data.serviceNameSnapshot == first.name + " + " + second.name &&
        data.durationMinutesSnapshot == first.durationMinutes + second.durationMinutes &&
        data.priceCentsSnapshot == first.priceCents + second.priceCents;
    }
    function threeServiceSnapshotIsCurrent(data) {
      let first = get(servicePath(data.serviceIds[0])).data;
      let second = get(servicePath(data.serviceIds[1])).data;
      let third = get(servicePath(data.serviceIds[2])).data;
      return data.serviceIds.toSet().size() == 3 &&
        first.active == true &&
        second.active == true &&
        third.active == true &&
        data.serviceId == data.serviceIds[0] + "+" + data.serviceIds[1] + "+" + data.serviceIds[2] &&
        data.serviceNameSnapshot == first.name + " + " + second.name + " + " + third.name &&
        data.durationMinutesSnapshot == first.durationMinutes + second.durationMinutes + third.durationMinutes &&
        data.priceCentsSnapshot == first.priceCents + second.priceCents + third.priceCents;
    }
    function fourServiceSnapshotIsCurrent(data) {
      let first = get(servicePath(data.serviceIds[0])).data;
      let second = get(servicePath(data.serviceIds[1])).data;
      let third = get(servicePath(data.serviceIds[2])).data;
      let fourth = get(servicePath(data.serviceIds[3])).data;
      return data.serviceIds.toSet().size() == 4 &&
        first.active == true &&
        second.active == true &&
        third.active == true &&
        fourth.active == true &&
        data.serviceId == data.serviceIds[0] + "+" + data.serviceIds[1] + "+" + data.serviceIds[2] + "+" + data.serviceIds[3] &&
        data.serviceNameSnapshot == first.name + " + " + second.name + " + " + third.name + " + " + fourth.name &&
        data.durationMinutesSnapshot == first.durationMinutes + second.durationMinutes + third.durationMinutes + fourth.durationMinutes &&
        data.priceCentsSnapshot == first.priceCents + second.priceCents + third.priceCents + fourth.priceCents;
    }
    function serviceSnapshotIsCurrent(data) {
      return data.serviceIds is list &&
        (data.serviceIds.size() == 1
        ? oneServiceSnapshotIsCurrent(data)
        : data.serviceIds.size() == 2
          ? twoServiceSnapshotIsCurrent(data)
          : data.serviceIds.size() == 3
            ? threeServiceSnapshotIsCurrent(data)
            : data.serviceIds.size() == 4 && fourServiceSnapshotIsCurrent(data));
    }
    function validBookingLock(data) {
      return data.keys().hasOnly(["bookingId", "createdAt", "updatedAt"]) &&
        data.keys().hasAll(["bookingId", "createdAt", "updatedAt"]) &&
        validOpaqueId(data.bookingId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }
    function lockMatchesBooking(uid, bookingId) {
      let lock = getAfter(bookingLockPath(uid)).data;
      return lock.bookingId == bookingId;
    }
    function lockReleasedForBooking(uid, bookingId) {
      return exists(bookingLockPath(uid)) &&
        get(bookingLockPath(uid)).data.bookingId == bookingId &&
        !existsAfter(bookingLockPath(uid));
    }
    function mayReplaceExistingLock(uid) {
      let currentLock = get(bookingLockPath(uid)).data;
      let currentBooking = get(bookingPath(currentLock.bookingId)).data;
      return exists(bookingLockPath(uid)) &&
        exists(bookingPath(currentLock.bookingId)) &&
        currentBooking.createdByUid == uid &&
        currentBooking.status in ["cancelled", "completed"];
    }
    function customerCreatesBookingLock(uid) {
      let lock = request.resource.data;
      let booking = getAfter(bookingPath(lock.bookingId)).data;
      return request.auth.uid == uid &&
        validBookingLock(lock) &&
        lock.createdAt == request.time &&
        lock.updatedAt == request.time &&
        existsAfter(bookingPath(lock.bookingId)) &&
        booking.createdByUid == uid &&
        booking.status == "pending" &&
        booking.lastCustomerMutation == "create" &&
        booking.createdAt == request.time;
    }
    function customerUpdatesBookingLock(uid) {
      let lock = request.resource.data;
      let booking = getAfter(bookingPath(lock.bookingId)).data;
      return request.auth.uid == uid &&
        validBookingLock(lock) &&
        lock.updatedAt == request.time &&
        booking.createdByUid == uid &&
        booking.status == "pending" &&
        (
          (lock.bookingId == resource.data.bookingId &&
            lock.createdAt == resource.data.createdAt &&
            booking.lastCustomerMutation == "reschedule" &&
            booking.updatedAt == request.time) ||
          (mayReplaceExistingLock(uid) &&
            lock.bookingId != resource.data.bookingId &&
            lock.createdAt == request.time &&
            booking.lastCustomerMutation == "create" &&
            booking.createdAt == request.time &&
            booking.updatedAt == request.time)
        );
    }
    function customerDeletesBookingLock(uid) {
      let booking = getAfter(bookingPath(resource.data.bookingId)).data;
      return request.auth.uid == uid &&
        existsAfter(bookingPath(resource.data.bookingId)) &&
        booking.createdByUid == uid &&
        booking.status == "cancelled" &&
        booking.lastCustomerMutation == "cancel" &&
        booking.updatedAt == request.time;
    }
    function availabilitySlots(data) {
      return data.keys().hasAny(["occupiedSlotKeys"])
        ? data.occupiedSlotKeys
        : data.occupiedSlots.keys();
    }
    function validAvailabilityMutationBase(dateKey, bookingId, mutationType) {
      let after = getAfter(availabilityPath(dateKey)).data;
      return after.lastMutationId == bookingId &&
        after.lastMutationType == mutationType &&
        after.updatedAt == request.time;
    }
    function validCreateAvailability(dateKey, slots, bookingId) {
      let afterSlots = getAfter(availabilityPath(dateKey)).data.occupiedSlotKeys;
      return validAvailabilityMutationBase(dateKey, bookingId, "create") &&
        (
          (!exists(availabilityPath(dateKey)) &&
            validNewAvailabilityList(afterSlots, slots)) ||
          (exists(availabilityPath(dateKey)) &&
            validExactAddition(
              availabilitySlots(get(availabilityPath(dateKey)).data),
              afterSlots,
              slots
            ))
        );
    }
    function validCancelAvailability(dateKey, slots, bookingId) {
      let beforeSlots = availabilitySlots(get(availabilityPath(dateKey)).data);
      let afterSlots = getAfter(availabilityPath(dateKey)).data.occupiedSlotKeys;
      return exists(availabilityPath(dateKey)) &&
        validAvailabilityMutationBase(dateKey, bookingId, "cancel") &&
        validExactRelease(beforeSlots, afterSlots, slots);
    }
    function validSameDateAvailability(dateKey, oldSlots, newSlots, bookingId) {
      let beforeSlots = availabilitySlots(get(availabilityPath(dateKey)).data);
      let afterSlots = getAfter(availabilityPath(dateKey)).data.occupiedSlotKeys;
      return validAvailabilityMutationBase(dateKey, bookingId, "reschedule-same") &&
        validSameDateSwap(beforeSlots, afterSlots, oldSlots, newSlots);
    }
    function validCrossDateAvailability(before, after, bookingId) {
      let sourceBeforeSlots = availabilitySlots(get(availabilityPath(before.dateKey)).data);
      let sourceAfterSlots = getAfter(availabilityPath(before.dateKey)).data.occupiedSlotKeys;
      let targetAfterSlots = getAfter(availabilityPath(after.dateKey)).data.occupiedSlotKeys;
      let targetExists = exists(availabilityPath(after.dateKey));
      return exists(availabilityPath(before.dateKey)) &&
        validAvailabilityMutationBase(before.dateKey, bookingId, "reschedule-source") &&
        validExactRelease(sourceBeforeSlots, sourceAfterSlots, before.occupiedSlotKeys) &&
        validAvailabilityMutationBase(after.dateKey, bookingId, "reschedule-target") &&
        (
          (!targetExists &&
            validNewAvailabilityList(targetAfterSlots, after.occupiedSlotKeys)) ||
          (targetExists &&
            validExactAddition(
              availabilitySlots(get(availabilityPath(after.dateKey)).data),
              targetAfterSlots,
              after.occupiedSlotKeys
            ))
        );
    }
    function validCustomerCreate(data, bookingId) {
      return validOpaqueId(bookingId) &&
        (!exists(bookingLockPath(request.auth.uid)) || mayReplaceExistingLock(request.auth.uid)) &&
        validCustomerCreateShape(data) &&
        data.createdByUid == request.auth.uid &&
        data.status == "pending" &&
        data.lastCustomerMutation == "create" &&
        !data.keys().hasAny(["paymentMethod"]) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time &&
        lockMatchesBooking(request.auth.uid, bookingId) &&
        serviceSnapshotIsCurrent(data) &&
        validTiming(data) &&
        validCreateAvailability(data.dateKey, data.occupiedSlotKeys, bookingId);
    }
    function validCustomerCancelData(before, after) {
      return ownsBooking(before) &&
        before.status in ["pending", "confirmed"] &&
        before.startAt > request.time &&
        after.status == "cancelled" &&
        after.lastCustomerMutation == "cancel" &&
        !after.keys().hasAny(["paymentMethod"]) &&
        after.expiresAt is timestamp &&
        after.expiresAt >= request.time + duration.value(179, 'd') &&
        after.expiresAt <= request.time + duration.value(181, 'd') &&
        after.updatedAt == request.time &&
        after.diff(before).affectedKeys().hasOnly(["status", "paymentMethod", "lastCustomerMutation", "expiresAt", "updatedAt"]);
    }
    function validCustomerCancel(before, after, bookingId) {
      return validCustomerCancelData(before, after) &&
        lockReleasedForBooking(request.auth.uid, bookingId) &&
        validCancelAvailability(before.dateKey, before.occupiedSlotKeys, bookingId);
    }
    function validCustomerRescheduleData(before, after) {
      let changed = after.diff(before).affectedKeys();
      let serviceChanged = changed.hasAny(["serviceId", "serviceIds", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot"]);
      return ownsBooking(before) &&
        before.status in ["pending", "confirmed"] &&
        before.startAt > request.time &&
        after.status == "pending" &&
        after.lastCustomerMutation == "reschedule" &&
        !after.keys().hasAny(["paymentMethod"]) &&
        after.updatedAt == request.time &&
        (after.dateKey != before.dateKey || after.startTime != before.startTime || serviceChanged) &&
        changed.hasOnly(["dateKey", "startTime", "endTime", "startAt", "endAt", "occupiedSlotKeys", "serviceId", "serviceIds", "serviceNameSnapshot", "durationMinutesSnapshot", "priceCentsSnapshot", "status", "paymentMethod", "lastCustomerMutation", "updatedAt"]) &&
        (!serviceChanged ||
          (after.keys().hasAny(["serviceIds"]) &&
            serviceSnapshotIsCurrent(after))) &&
        validRescheduleFields(after);
    }
    function validCustomerReschedule(before, after, bookingId) {
      return validCustomerRescheduleData(before, after) &&
        lockMatchesBooking(request.auth.uid, bookingId) &&
        validTiming(after) &&
        (
          (before.dateKey == after.dateKey &&
            validSameDateAvailability(
              before.dateKey,
              before.occupiedSlotKeys,
              after.occupiedSlotKeys,
              bookingId
            )) ||
          (before.dateKey != after.dateKey &&
            validCrossDateAvailability(before, after, bookingId))
        );
    }
    function validNewAvailabilityList(afterSlots, slots) {
      let afterSet = afterSlots.toSet();
      return afterSet == slots.toSet() &&
        afterSlots.size() == slots.size();
    }
    function validExactAddition(beforeSlots, afterSlots, slots) {
      let beforeSet = beforeSlots.toSet();
      let afterSet = afterSlots.toSet();
      let slotSet = slots.toSet();
      return beforeSet.intersection(slotSet).size() == 0 &&
        afterSet == beforeSet.union(slotSet) &&
        afterSlots.size() == afterSet.size();
    }
    function validExactRelease(beforeSlots, afterSlots, slots) {
      let beforeSet = beforeSlots.toSet();
      let afterSet = afterSlots.toSet();
      return beforeSet.hasAll(slots) &&
        afterSet == beforeSet.difference(slots.toSet()) &&
        afterSlots.size() == afterSet.size();
    }
    function validSameDateSwap(beforeSlots, afterSlots, oldSlots, newSlots) {
      let beforeSet = beforeSlots.toSet();
      let afterSet = afterSlots.toSet();
      let newSet = newSlots.toSet();
      return beforeSet.hasAll(oldSlots) &&
        beforeSet.intersection(newSet).hasOnly(oldSlots) &&
        afterSet == beforeSet.difference(oldSlots.toSet()).union(newSet) &&
        afterSlots.size() == afterSet.size();
    }
    function customerCreatedBookingForDate(bookingId, dateKey) {
      let after = getAfter(bookingPath(bookingId)).data;
      let settings = get(settingsPath()).data;
      return existsAfter(bookingPath(bookingId)) &&
        after.createdByUid == request.auth.uid &&
        after.createdAt == request.time &&
        after.updatedAt == request.time &&
        after.status == "pending" &&
        after.lastCustomerMutation == "create" &&
        after.dateKey == dateKey &&
        fitsConfiguredSchedule(after, settings, timeMinutes(after.startTime));
    }
    function customerCancelledBookingForDate(bookingId, dateKey) {
      let after = getAfter(bookingPath(bookingId)).data;
      return existsAfter(bookingPath(bookingId)) &&
        after.createdByUid == request.auth.uid &&
        after.updatedAt == request.time &&
        after.lastCustomerMutation == "cancel" &&
        after.dateKey == dateKey &&
        after.status == "cancelled";
    }
    function customerRescheduledBookingForDate(bookingId, dateKey, mutationType) {
      let before = get(bookingPath(bookingId)).data;
      let after = getAfter(bookingPath(bookingId)).data;
      let settings = get(settingsPath()).data;
      return after.createdByUid == request.auth.uid &&
        after.updatedAt == request.time &&
        after.lastCustomerMutation == "reschedule" &&
        after.status == "pending" &&
        (mutationType == "reschedule-source" ||
          fitsConfiguredSchedule(after, settings, timeMinutes(after.startTime))) &&
        (
          (mutationType == "reschedule-same" &&
            before.dateKey == dateKey &&
            after.dateKey == dateKey) ||
          (mutationType == "reschedule-source" &&
            before.dateKey == dateKey &&
            after.dateKey != dateKey) ||
          (mutationType == "reschedule-target" &&
            before.dateKey != dateKey &&
            after.dateKey == dateKey)
        );
    }
    function customerAvailabilityCreate(dateKey) {
      let mutationType = request.resource.data.lastMutationType;
      let bookingId = request.resource.data.lastMutationId;
      return signedIn() &&
        validCustomerAvailabilityShape(request.resource.data) &&
        (
          (mutationType == "create" &&
            customerCreatedBookingForDate(bookingId, dateKey)) ||
          (mutationType == "reschedule-target" &&
            customerRescheduledBookingForDate(bookingId, dateKey, mutationType))
        );
    }
    function customerAvailabilityUpdate(dateKey) {
      let mutationType = request.resource.data.lastMutationType;
      let bookingId = request.resource.data.lastMutationId;
      return signedIn() &&
        validCustomerAvailabilityShape(request.resource.data) &&
        (
          (
            mutationType == "create" &&
            customerCreatedBookingForDate(bookingId, dateKey)
          ) ||
          (
            mutationType == "cancel" &&
            customerCancelledBookingForDate(bookingId, dateKey)
          ) ||
          (
            mutationType == "reschedule-same" &&
            customerRescheduledBookingForDate(bookingId, dateKey, mutationType)
          ) ||
          (
            mutationType == "reschedule-source" &&
            customerRescheduledBookingForDate(bookingId, dateKey, mutationType)
          ) ||
          (
            mutationType == "reschedule-target" &&
            customerRescheduledBookingForDate(bookingId, dateKey, mutationType)
          )
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }
    match /customerBookingLocks/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if
        (isPublicClient() && customerCreatesBookingLock(uid)) ||
        (isOwner() && validBookingLock(request.resource.data));
      allow update: if
        (isPublicClient() && customerUpdatesBookingLock(uid)) ||
        (isOwner() && validBookingLock(request.resource.data));
      allow delete: if
        (isPublicClient() && customerDeletesBookingLock(uid)) ||
        isOwner();
    }
    match /settings/{settingsId} {
      allow get: if settingsId == "public" && signedIn();
      allow list: if isOwner();
      allow create, update: if isOwner() &&
        settingsId == "public" &&
        validSettings(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /services/{serviceId} {
      allow get: if signedIn() && (resource.data.active == true || isOwner());
      allow list: if signedIn() && (resource.data.active == true || isOwner());
      allow create: if isOwner() &&
        validService(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner() &&
        validService(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }
    match /exceptions/{dateKey} {
      allow get, list: if signedIn();
      allow create, update: if isOwner() &&
        validException(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }
    match /publicAvailability/{dateKey} {
      allow get, list: if signedIn();
      allow create: if
        (isPublicClient() && customerAvailabilityCreate(dateKey)) ||
        (isOwner() && validAvailability(request.resource.data) && request.resource.data.updatedAt == request.time);
      allow update: if
        (isPublicClient() && customerAvailabilityUpdate(dateKey)) ||
        (isOwner() && validAvailability(request.resource.data) && request.resource.data.updatedAt == request.time);
      allow delete: if isOwner();
    }
    match /bookings/{bookingId} {
      allow get: if ownsBooking(resource.data) || isOwner();
      allow list: if ownsBooking(resource.data) || isOwner();
      allow create: if
        (isPublicClient() && validCustomerCreate(request.resource.data, bookingId)) ||
        (isOwner() && validBookingShape(request.resource.data));
      allow update: if
        (isPublicClient() && (
          (request.resource.data.lastCustomerMutation == "cancel" &&
            validCustomerCancel(resource.data, request.resource.data, bookingId)) ||
          (request.resource.data.lastCustomerMutation == "reschedule" &&
            validCustomerReschedule(resource.data, request.resource.data, bookingId))
        )) ||
        (isOwner() &&
          validBookingShape(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time);
      allow delete: if isOwner();
    }
    match /financialSummaries/{monthKey} {
      allow read: if isOwner();
      allow create, update: if isOwner() &&
        validSummary(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
